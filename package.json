{
  "name": "langchain-codex",
  "version": "0.6.0",
  "description": "LangChain.js chat model adapter for OpenAI Codex SDK.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "author": "Euan Cowie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euan-cowie/langchain-codex.git"
  },
  "bugs": {
    "url": "https://github.com/euan-cowie/langchain-codex/issues"
  },
  "homepage": "https://github.com/euan-cowie/langchain-codex#readme",
  "keywords": [
    "langchain",
    "langgraph",
    "codex",
    "openai",
    "typescript",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "RUN_CODEX_INTEGRATION_TESTS=1 vitest run test/integration",
    "test:integration:app-server": "CODEX_APP_SERVER_INTEGRATION=1 vitest run test/integration/app_server_runtime.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changeset.mjs",
    "changeset:status": "changeset status",
    "version": "changeset version",
    "release": "changeset publish",
    "release:github": "node scripts/create-github-release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "smoke:package": "node scripts/smoke-test-package.mjs"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "ajv": "^6.15.0",
    "@openai/codex": "^0.125.0",
    "@openai/codex-sdk": "^0.125.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  }
}
